{
  "name": "zeus",
  "version": "0.1.0",
  "private": true,
  "description": "Zeus desktop app built with Electron, React, TypeScript, and Vite.",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexbguthrie/Zeus.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:browser": "vite --config vite.renderer.config.ts --host 127.0.0.1",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.renderer.json",
    "check": "npm run typecheck && npm run format:check",
    "build": "npm run check && electron-vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "45.2.1",
    "electron-vite": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
